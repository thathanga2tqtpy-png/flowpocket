# Environment Mode (local | test | production)
APP_ENV=local

# PostgreSQL Configuration
POSTGRES_DB=flowpocket
POSTGRES_USER=flowpocket_app
POSTGRES_PASSWORD=your_strong_postgres_password_here
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Backend Database URL (Internal use only - do NOT expose to frontend)
DATABASE_URL=postgresql+psycopg://flowpocket_app:your_strong_postgres_password_here@127.0.0.1:5432/flowpocket

# Security & Sessions
APP_SECRET_KEY=change_this_to_a_long_random_secret_at_least_32_chars
SESSION_COOKIE_NAME=flowpocket_session
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE_SECONDS=604800

# CORS & Frontend Origins
FRONTEND_ORIGIN=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Backend Server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8001

# Frontend Public Backend URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001
NEXT_PUBLIC_API_URL=http://localhost:8001

#Host


